# ==============================================================================
# PERSONAL BANK — LOCAL ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and fill in your actual private credentials.
# ==============================================================================

# MongoDB Atlas Production Connection String (Points to database: personal_bank)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/personal_bank?retryWrites=true&w=majority"

# Optional Isolated Test Database (used exclusively during automated test runs)
MONGODB_URI_TEST="mongodb+srv://<username>:<password>@<cluster-host>/personal_bank_test?retryWrites=true&w=majority"

# Optional Canonical Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Metadata
NEXT_PUBLIC_APP_NAME="Personal Bank"

# Optional Upstash Redis for distributed rate-limiting (falls back to local memory if omitted)
UPSTASH_REDIS_REST_URL="https://<your-upstash-instance>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<your-upstash-token>"

# Android Trusted Web Activity Identity & Digital Asset Links
ANDROID_PACKAGE_NAME="com.sumitjagtap.personalbank"
ANDROID_SHA256_FINGERPRINT="00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00"

