# ==============================================================================
# PERSONAL BANK — VERCEL & ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# For Vercel deployment, configure these variables under:
# Project Settings -> Environment Variables
# ==============================================================================

# [REQUIRED FOR PRODUCTION]
# MongoDB Atlas Production Connection String (Points to database: personal_bank)
# Set in Vercel under Environment: "Production"
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/personal_bank?retryWrites=true&w=majority"

# [RECOMMENDED FOR PREVIEW DEPLOYMENTS]
# MongoDB Atlas Test Database (Points to database: personal_bank_test)
# Set in Vercel under Environment: "Preview" & "Development"
MONGODB_URI_TEST="mongodb+srv://<username>:<password>@<cluster-host>/personal_bank_test?retryWrites=true&w=majority"

# [OPTIONAL] Canonical App URL for social preview and metadata (without trailing slash)
# e.g., https://personalbank.app or https://your-project.vercel.app
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# [OPTIONAL] Application Display Name
NEXT_PUBLIC_APP_NAME="Personal Bank"

# [RECOMMENDED FOR DISTRIBUTED RATE LIMITING]
# Upstash Redis REST credentials for distributed serverless rate limiting
# Set in Vercel under Environment: "Production" & "Preview"
UPSTASH_REDIS_REST_URL="https://<your-upstash-instance>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<your-upstash-token>"

# [DEVELOPER PORTFOLIO] Verified URL for Developer Portfolio in Settings
NEXT_PUBLIC_PORTFOLIO_URL="https://sumitjagtap.vercel.app/"
